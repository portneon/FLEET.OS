    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.x",
    "@types/node": "^20.x",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.x",
    "prisma": "^5.x",
    "ts-node": "^10.x",
    "typescript": "^5.x"
