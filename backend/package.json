  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.x",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "nodemon": "^3.x",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
