// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



enum Role {
  ADMIN
  DISPATCHER
  DRIVER
  FINANCE
  ROUTE_PLANNER
  PASSENGER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum VehicleType {
  BUS
  TRUCK
  VAN
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TransactionType {
  INCOME
  EXPENSE
}



enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  SALARY
  INSURANCE
  TAX
  TOLL
  RENT
  PARKING
  LOAN_PAYMENT
  OTHER
}

enum ReceivableStatus {
  PENDING
  PAID
  OVERDUE
}

enum PayableStatus {
  PENDING
  PAID
  OVERDUE
}



model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  vehicles     Vehicle[]
  transactions Transaction[]
  fleets       Fleet[]
  routes       Route[]
  stops        Stop[]
  trips        Trip[]
  bookings     Booking[]

  // Finance relations
  customers   Customer[]
  invoices    Invoice[]
  expenses    Expense[]
  receivables Receivable[]
  payables    Payable[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  password       String
  role           Role         @default(DRIVER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  driverProfile DriverProfile?
  bookings      Booking[]

  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

model DriverProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  licenseNumber String       @unique
  experience    Int
  performance   Float        @default(5.0)
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())

  wallets Wallet[]
  loans   Loan[]
  trips   Trip[]

  // Finance relations
  payrolls Payroll[]
  expenses Expense[]
}

model Vehicle {
  id              String      @id @default(uuid())
  vin             String      @unique // 17-character unique identifier
  type            VehicleType
  licensePlate    String      @unique
  seatingCapacity Int? // Required if type is BUS
  status          String      @default("IDLE")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  fleetId String?
  fleet   Fleet?  @relation(fields: [fleetId], references: [id])


  purchasePrice     Float?
  purchaseDate      DateTime?
  residualValue     Float?
  insuranceCost     Float?
  loanAmount        Float?
  monthlyEmi        Float?
  expectedLifeYears Int?

  trips           Trip[]
  telemetry       Telemetry[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  expenses        Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fleet {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicles       Vehicle[]
  createdAt      DateTime     @default(now())
}

model Route {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  stops          RouteStop[]
  trips          Trip[]
  createdAt      DateTime     @default(now())
}

model Stop {
  id             String       @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  routeStops     RouteStop[]
  createdAt      DateTime     @default(now())
}

model RouteStop {
  id       String @id @default(uuid())
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId   String
  stop     Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  sequence Int

  @@unique([routeId, sequence])
}

model Booking {
  id             String        @id @default(uuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  status         BookingStatus @default(CONFIRMED)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}

model Trip {
  id             String        @id @default(uuid())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  driverId       String
  driver         DriverProfile @relation(fields: [driverId], references: [id])
  status         TripStatus    @default(SCHEDULED)
  scheduledStart DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  bookings Booking[]

  // Finance relations
  invoices Invoice[]
  expenses Expense[]
  fuelLogs FuelLog[]

  createdAt DateTime @default(now())
}

model Telemetry {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
}

model Wallet {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  balance         Float         @default(0)
  updatedAt       DateTime      @updatedAt
}

model Loan {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  amount          Float
  paidAmount      Float         @default(0)
  status          String        @default("ACTIVE") // ACTIVE, REPAID
  createdAt       DateTime      @default(now())
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  category    String
  description String?
  date        DateTime        @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}


model Customer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  customerType   CustomerType
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
}

model Invoice {
  id             String  @id @default(uuid())
  organizationId String
  customerId     String
  tripId         String?

  subtotal Float
  tax      Float
  discount Float @default(0)
  total    Float

  status InvoiceStatus @default(PENDING)

  issuedAt DateTime  @default(now())
  dueDate  DateTime
  paidAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  trip         Trip?        @relation(fields: [tripId], references: [id])

  payments   Payment[]
  receivable Receivable?
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  amount    Float
  method    PaymentMethod
  status    PaymentStatus
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id             String @id @default(uuid())
  organizationId String

  vehicleId String?
  driverId  String?
  tripId    String?

  category ExpenseCategory
  amount   Float
  vendor   String?
  notes    String?

  expenseDate DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id])
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id])
  driver       DriverProfile? @relation(fields: [driverId], references: [id])
  trip         Trip?          @relation(fields: [tripId], references: [id])
}

model FuelLog {
  id        String  @id @default(uuid())
  vehicleId String
  tripId    String?

  liters   Float
  cost     Float
  odometer Float
  filledAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])
}

model MaintenanceLog {
  id              String  @id @default(uuid())
  vehicleId       String
  maintenanceType String
  cost            Float
  vendor          String?
  notes           String?

  servicedAt DateTime  @default(now())
  nextDue    DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model Payroll {
  id       String   @id @default(uuid())
  driverId String
  month    DateTime

  baseSalary Float
  bonus      Float @default(0)
  deductions Float @default(0)
  netPay     Float

  paidAt DateTime?

  driver DriverProfile @relation(fields: [driverId], references: [id])
}

model Receivable {
  id             String @id @default(uuid())
  organizationId String
  invoiceId      String @unique

  amountDue Float
  dueDate   DateTime
  status    ReceivableStatus

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
}

model Payable {
  id             String @id @default(uuid())
  organizationId String

  vendor  String
  amount  Float
  dueDate DateTime
  status  PayableStatus

  organization Organization @relation(fields: [organizationId], references: [id])
}
