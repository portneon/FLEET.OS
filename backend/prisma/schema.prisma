// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  users        User[]
  vehicles     Vehicle[]
  transactions Transaction[]
  fleets       Fleet[]
  routes       Route[]
  stops        Stop[]
  trips        Trip[]
  bookings     Booking[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  password       String
  role           Role         @default(DRIVER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  driverProfile DriverProfile?
  bookings      Booking[]

  createdAt     DateTime       @default(now())
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
  FINANCE
  ROUTE_PLANNER
  PASSENGER
}

model DriverProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  licenseNumber String       @unique
  experience    Int
  performance   Float        @default(5.0)
  status        DriverStatus @default(AVAILABLE)
  createdAt     DateTime     @default(now())

  wallets Wallet[]
  loans   Loan[]
  trips   Trip[]
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum VehicleType {
  BUS
  TRUCK
  VAN
}

model Vehicle {
  id              String      @id @default(uuid())
  vin             String      @unique // 17-character unique identifier
  type            VehicleType
  licensePlate    String      @unique
  seatingCapacity Int? // Required if type is BUS
  status          String      @default("IDLE") //

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  fleetId String?
  fleet   Fleet?  @relation(fields: [fleetId], references: [id])

  trips     Trip[]
  telemetry Telemetry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fleet {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicles       Vehicle[]
  createdAt      DateTime     @default(now())
}

model Route {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  stops          RouteStop[]
  trips          Trip[]
  createdAt      DateTime     @default(now())
}

model Stop {
  id             String       @id @default(uuid())
  name           String
  latitude       Float
  longitude      Float
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  routeStops     RouteStop[]
  createdAt      DateTime     @default(now())
}

model RouteStop {
  id       String @id @default(uuid())
  routeId  String
  route    Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId   String
  stop     Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  sequence Int

  @@unique([routeId, sequence])
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id             String        @id @default(uuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  status         BookingStatus @default(CONFIRMED)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
}

model Trip {
  id             String        @id @default(uuid())
  routeId        String
  route          Route         @relation(fields: [routeId], references: [id])
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  driverId       String
  driver         DriverProfile @relation(fields: [driverId], references: [id])
  status         TripStatus    @default(SCHEDULED)
  scheduledStart DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  bookings       Booking[]
  createdAt      DateTime      @default(now())
}

model Telemetry {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
}

model Wallet {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  balance         Float         @default(0)
  updatedAt       DateTime      @updatedAt
}

model Loan {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  amount          Float
  paidAmount      Float         @default(0)
  status          String        @default("ACTIVE") // ACTIVE, REPAID
  createdAt       DateTime      @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Float
  type        TransactionType
  category    String
  description String?
  date        DateTime        @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}
